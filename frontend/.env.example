# Copy this file to `.env.local` and adjust values for your machine.

# Frontend
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_LLM_FIX_ENDPOINT=https://simotstestengine-production.up.railway.app/verification/fix
NEXT_PUBLIC_DIRECT_FIX_ENDPOINT=https://simotstestengine-production.up.railway.app/verification/fix

# Backend proxy targets
VERIFICATION_PROXY_URL=https://simotstestengine-production.up.railway.app
FIX_PROXY_URL=https://simotstestengine-production.up.railway.app

# External repair API used after local rule-based fixes
REPAIR_API_URL=ttps://overhead-anticipated-carroll-rainbow.trycloudflare.com/repair
REVERIFY_BASE_URL=https://simotstestengine-production.up.railway.app

# Timeouts (seconds)
REPAIR_TIMEOUT_SECONDS=120
FIX_MAX_CONTEXT_CHARS=30000
FIX_REQUEST_TIMEOUT_SECONDS=120
TEST_ENGINE_TIMEOUT_SECONDS=90

