# Copy this file to `.env.local` and adjust values for your machine.

# Frontend
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_LLM_FIX_ENDPOINT=http://127.0.0.1:8000/verification/fix
NEXT_PUBLIC_DIRECT_FIX_ENDPOINT=http://127.0.0.1:8000/verification/fix

# Backend proxy targets
VERIFICATION_PROXY_URL=http://127.0.0.1:8000
FIX_PROXY_URL=http://127.0.0.1:8000

# External repair API used after local rule-based fixes
REPAIR_API_URL=https://fridge-mesa-sas-amsterdam.trycloudflare.com/repair
REVERIFY_BASE_URL=http://te.amrc.kr

# Timeouts (seconds)
REPAIR_TIMEOUT_SECONDS=120
FIX_MAX_CONTEXT_CHARS=30000
FIX_REQUEST_TIMEOUT_SECONDS=120
TEST_ENGINE_TIMEOUT_SECONDS=90
